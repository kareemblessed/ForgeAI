# Copy to .env.local (never commit real keys) and fill in.

# Browser (Vite) — Supabase project → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Browser (Vite) — Google AI Studio key.
# NOTE: VITE_ variables are bundled into the site, so anyone can read this key.
# Restrict it to your site's domain (HTTP referrers) and set a quota in Google Cloud.
VITE_GEMINI_API_KEY=

# Server only (Vercel → Project → Settings → Environment Variables), used by /api/room
DAILY_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
